{
  "name": "self-contained-markdown-exporter",
  "version": "0.1.0",
  "private": true,
  "description": "Plugin de Obsidian para copiar y exportar una nota como Markdown autocontenido.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test --test-reporter spec \"tests/**/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && node scripts/check-dist.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "obsidian": "^1.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
